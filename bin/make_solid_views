#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-3.0-or-later
"""Standard SoLID line drawings: write the geometry scene, then render it with solid_lineview.

usage (inside eic-shell / solid-shell, after `source thissolid.sh <config>`):
    make_solid_views [-c CONFIG] [-o OUTDIR] [--source scene|dawnfile] [--scene FILE | --prim FILE] [-n EVENTS]
                     [--views v1,v2,...] [--formats svg,pdf,png] [--name FORMAT] [--field FILE] [--animate]

Geometry source (--source):
    scene        (default) solid_scene_dump writes scene.npz: the Geant4 polyhedra of all visible volumes with
                 names, colours and DD4hep volume IDs. No ddsim run, no vis driver; a few seconds.
    dawnfile     ddsim runs with the Geant4 DAWNFILE vis driver, which writes a g4_XXXX.prim file. The fallback
                 and reference: the same drawings, without volume IDs. With -n EVENTS it draws the Geant4
                 trajectories and hit markers the driver writes (no times, no energies).
--scene FILE or --prim FILE draws an existing file of either kind instead (the two options are synonyms).

Views (all in the GEMC hall frame, beam from left to right):
    section_yz   exact cut at x = 0, filled with the vis colors (the classic SoLID side-view layout)
    section_xz   exact cut at y = 0 (top view)
    cutaway      3-D hidden-line drawing of the far half (x > 0) seen from the -x side: interior visible (DAWN-style)
    lines_yz     side view, hidden-line removed outlines of the half x > 0 (black on white, no fill)
    beam_<z>     beam-eye section at z = <z> cm (x-y plane), e.g. beam_440 for the forward EC
    overview     labelled detector overview (not in the default list): the cutaway from a lower camera, beam line
                 trimmed to the detector, beam arrow, a callout label per subsystem (solid_lineview --labels solid)
                 and the configuration's display name as title (compact file as subtitle); PNG about 1600 px wide.
                 The README figures:
                     make_solid_views --views overview --formats svg,png --name '{view}_{config}' -o docs/images
    field_yz     the x = 0 section with the magnetic field under it: |B| in colour bands, field lines, direction
                 arrows, iron in grey, a callout label per subsystem (solid_lineview --field). The field is the
                 total field of the configuration (solenoid map, target magnet, ...): solid_field_dump samples it
                 through DD4hep on the section plane, so the drawing shows what the simulation uses.
                 --field FILE draws a given file instead: a GEMC 2-D map, or a field.npz of solid_field_dump.
                     make_solid_views --views field_yz --formats svg,png --name '{view}_{config}' -o docs/images
    field_xz     the same in the y = 0 section, seen from above (x up). The polarized NH3 target magnet has its
                 field along x: it lies in this plane, and points out of the plane of field_yz.
    field_target the y = 0 section around the target (1 m on each side of it), with its field
Events (-n EVENTS > 0): ddsim runs the default particle gun of steering/solid_sim.py with the geometry scene
(SOLID_SCENE) and the trajectory recorder (SOLID_TRAJ), solid_evexport writes one event file per event, and
solid_evview draws them: tracks coloured by particle type, hit markers, volumes coloured by deposited energy,
with a legend and a colour bar. Several events are overlaid in one figure. Views with events:
    event_side   section through the beam axis in the event plane (one event) or at x = 0 (several)
    event_zoom   the same around the volume with the largest energy deposit
    event_beam   beam-eye section just behind the front face of that volume
    event_cutaway  3-D hidden-line drawing cut at that plane
    section_yz, section_xz, cutaway, beam_<z>   the standard views with the events on top
These are the default views with -n: event_side, event_beam, event_cutaway. lines_yz, overview and the field
views are drawn without events. --animate adds an animation of event_side (GIF and animated SVG, see solid_evview --help).
--keep keeps the simulation output and the event files. docs/event_display.md describes the tools.

With --source dawnfile G4DAWNFILE_VIEWER is set to 'true' so that the legacy DAWN program is not started. For
dawn or dawncut, `solid_scene_dump --prim FILE` writes a .prim from the scene. Rendering needs only numpy
(+ pycairo or matplotlib for PNG). --keep keeps the work directory with the scene.npz or .prim file.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))

VIEWS = {
    'section_yz': ['--mode', 'section', '--section', 'x=0', '--view', 'side', '--fill', '--scale-bar'],
    'section_xz': ['--mode', 'section', '--section', 'y=0', '--view', 'top', '--fill', '--scale-bar'],
    'cutaway':    ['--mode', 'hlr', '--dawncut', '-1', '0', '0', '0', '--view', 'iso', '--perspective', '40000',
                   '--no-traj', '--no-hits'],
    'lines_yz':   ['--mode', 'hlr', '--dawncut', '-1', '0', '0', '0', '--view', 'side'],
    'overview':   ['--mode', 'hlr', '--dawncut', '-1', '0', '0', '0', '--view-dir', '-0.80', '0.30', '-0.52',
                   '--perspective', '40000', '--size', '1600x1100', '--dpi', '200', '--hlr-scale', '2',
                   '--lw', '0.4', '--lw-outline', '0.8', '--lw-cut', '0.9', '--trim', 'Beamline=auto',
                   '--trim-margin', '0.015', '--beam-arrow', '--labels', 'solid', '--title-bold',
                   '--title-size', '13', '--no-traj', '--no-hits'],
}
# field views: (plane of solid_field_dump, solid_lineview options, the plane in words)
FIELD_BASE = ['--mode', 'section', '--scale-bar', '--labels', 'solid', '--size', '2000x1000', '--dpi', '150',
              '--lw', '0.5', '--title-bold', '--title-size', '13']
FIELD_VIEWS = {
    'field_yz': ('x=0', ['--section', 'x=0', '--view', 'side'], 'x = 0 section'),
    'field_xz': ('y=0', ['--section', 'y=0', '--view', 'top'], 'y = 0 section seen from above'),
    'field_target': ('y=0', ['--section', 'y=0', '--view', 'top', '--fit-volumes', r'(^|!)Target_', '--fit-pad', '1m',
                             '--field-arrows', '25cm', '--size', '1500x1500'],
                     'y = 0 section around the target, seen from above'),
}

DEFAULT_VIEWS = 'section_yz,section_xz,cutaway,lines_yz'
DEFAULT_EVENT_VIEWS = 'event_side,event_beam,event_cutaway'
# views drawn by solid_evview when events were simulated: its view and the plane azimuth (None: the event plane)
EVENT_VIEWS = {
    'event_side': ('side', None), 'event_zoom': ('zoom', None), 'event_beam': ('beam', None),
    'event_cutaway': ('cutaway', None),
    'section_yz': ('side', 90.0), 'section_xz': ('side', 0.0), 'cutaway': ('cutaway', 90.0),
}

# figure titles and subtitle of the 'overview' view (other views are titled '<config>: <view>')
DISPLAY_NAMES = {
    'solid': 'SoLID SIDIS, polarized ³He target',
    'solid_SIDIS_He3': 'SoLID SIDIS, polarized ³He target',
    'solid_SIDIS_NH3': 'SoLID SIDIS, polarized NH₃ target',
    'solid_PVDIS': 'SoLID PVDIS, LD₂ target',
    'solid_JPsi': 'SoLID J/ψ, LH₂ target',
    'solid_DDVCS': 'SoLID J/ψ and DDVCS (forward muon detector)',
    'solid_JPsi_lite': 'SoLID-Lite J/ψ',
    'solid_DDVCS_lite': 'SoLID-Lite DDVCS',
}
SUBTITLE = '{config}.xml · DD4hep geometry, half cut away at x = 0 to show the interior'

MACRO_GEOMETRY = """/vis/open DAWNFILE
/vis/viewer/set/lineSegmentsPerCircle {segments}
/vis/scene/create
/vis/scene/add/volume
/vis/sceneHandler/attach
/vis/viewer/flush
"""
MACRO_EVENTS = """/vis/open DAWNFILE
/vis/viewer/set/lineSegmentsPerCircle {segments}
/vis/scene/create
/vis/scene/add/volume
/vis/sceneHandler/attach
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/scene/add/hits
/vis/scene/endOfEventAction accumulate
/run/beamOn {events}
"""


def find_lineview():
    for cand in (os.path.join(HERE, 'solid_lineview'), shutil.which('solid_lineview') or ''):
        if cand and os.path.exists(cand):
            return cand
    sys.exit('make_solid_views: solid_lineview not found next to this script or on PATH')


def find_tool(name):
    for cand in (os.path.join(HERE, name), shutil.which(name) or ''):
        if cand and os.path.exists(cand):
            return cand
    sys.exit('make_solid_views: %s not found next to this script or on PATH' % name)


def make_events(compact, workdir, events, segments, steering):
    """ddsim with the scene producer and the trajectory recorder, then solid_evexport: (scene.npz, event dir)"""
    scene = os.path.join(workdir, 'scene.npz')
    traj = os.path.join(workdir, 'traj.bin')
    sim = os.path.join(workdir, 'views_sim.edm4hep.root')
    env = dict(os.environ, SOLID_SCENE=scene, SOLID_SCENE_SEGMENTS=str(segments), SOLID_TRAJ=traj, SOLID_OPTICAL='0')
    cmd = ['ddsim', '--steeringFile', steering, '--compactFile', compact, '-N', str(events), '--outputFile', sim]
    print('+', ' '.join(cmd), flush=True)
    with open(os.path.join(workdir, 'ddsim.log'), 'w') as log:
        r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, env=env, cwd=workdir, timeout=36000,
                           check=False)
    if r.returncode != 0 or not all(os.path.isfile(f) for f in (scene, traj, sim)):
        sys.exit(f'make_solid_views: ddsim failed or wrote no scene or trajectories, see {workdir}/ddsim.log '
                 '(--source dawnfile uses the Geant4 DAWNFILE driver instead)')
    evdir = os.path.join(workdir, 'events')
    cmd = [sys.executable, find_tool('solid_evexport'), sim, '--scene', scene, '--traj', traj, '-o', evdir]
    print('+', ' '.join(cmd), flush=True)
    if subprocess.run(cmd).returncode != 0:
        print('make_solid_views: solid_evexport reported hits without a unique drawn volume', file=sys.stderr)
    return scene, evdir


def find_binary(name):
    """a compiled tool: installed next to this script, on PATH, or in the build tree of a source checkout"""
    for cand in (os.path.join(HERE, name), shutil.which(name) or '',
                 os.path.join(os.path.dirname(HERE), 'build', 'bin', name)):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def make_field(compact, workdir, plane):
    """solid_field_dump: the total field of the configuration on a plane -> field.npz"""
    tool = find_binary('solid_field_dump')
    if not tool:
        print('make_solid_views: solid_field_dump not found (build and install solid_dd4hep, or give --field FILE)',
              file=sys.stderr)
        return None
    out = os.path.join(workdir, 'field_%s.npz' % plane.replace('=', ''))
    cmd = [tool, compact, '--plane', plane, '-o', out]
    print('+', ' '.join(cmd), flush=True)
    with open(os.path.join(workdir, 'solid_field_dump.log'), 'a') as log:
        r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, cwd=workdir, timeout=3600, check=False)
    if r.returncode != 0 or not os.path.isfile(out):
        print(f'make_solid_views: no field file produced, see {workdir}/solid_field_dump.log', file=sys.stderr)
        return None
    return out


def make_scene(compact, workdir, segments):
    tool = find_binary('solid_scene_dump')
    if not tool:
        sys.exit('make_solid_views: solid_scene_dump not found (build and install solid_dd4hep, or use '
                 '--source dawnfile)')
    scene = os.path.join(workdir, 'scene.npz')
    cmd = [tool, compact, '-o', scene, '--segments', str(segments)]
    print('+', ' '.join(cmd), flush=True)
    with open(os.path.join(workdir, 'solid_scene_dump.log'), 'w') as log:
        r = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, cwd=workdir, timeout=3600, check=False)
    if r.returncode != 0 or not os.path.isfile(scene):
        sys.exit(f'make_solid_views: no scene produced, see {workdir}/solid_scene_dump.log '
                 '(--source dawnfile uses the Geant4 DAWNFILE driver instead)')
    return scene


def make_prim(compact, workdir, events, segments, steering):
    macro = os.path.join(workdir, 'dawnfile.mac')
    with open(macro, 'w') as f:
        f.write((MACRO_EVENTS if events > 0 else MACRO_GEOMETRY).format(events=events, segments=segments))
    env = dict(os.environ, G4DAWNFILE_VIEWER='true', SOLID_OPTICAL='0')
    cmd = ['ddsim', '--compactFile', compact, '--runType', 'vis', '--macroFile', macro,
           '--outputFile', os.path.join(workdir, 'views_sim.edm4hep.root')]
    if steering and os.path.exists(steering):
        cmd[1:1] = ['--steeringFile', steering]
    print('+', ' '.join(cmd), flush=True)
    with open(os.path.join(workdir, 'ddsim.log'), 'w') as log:
        # 'vis' starts an interactive session after the macro: feed it 'exit'
        subprocess.run(cmd, input=b'exit\n', stdout=log, stderr=subprocess.STDOUT, env=env, cwd=workdir,
                       timeout=3600, check=False)
    prims = sorted(p for p in os.listdir(workdir) if p.endswith('.prim'))
    if not prims:
        sys.exit(f'make_solid_views: no .prim produced, see {workdir}/ddsim.log')
    return os.path.join(workdir, prims[-1])


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('-c', '--config', default=os.environ.get('DETECTOR_CONFIG', 'solid'))
    ap.add_argument('-o', '--outdir', default='views_out')
    ap.add_argument('-n', '--events', type=int, default=0, help='events to simulate and draw (default 0 = '
                    'geometry only)')
    ap.add_argument('--animate', action='store_true', help='with -n: also animate the event_side view')
    ap.add_argument('--source', choices=('scene', 'dawnfile'), default='scene',
                    help='geometry source: scene (solid_scene_dump, default) or dawnfile (ddsim + DAWNFILE driver)')
    ap.add_argument('--scene', '--prim', dest='prim', default=None, metavar='FILE',
                    help='draw an existing scene.npz or .prim file instead of producing one')
    ap.add_argument('--views', default=None, help='comma list; beam_<z_cm> for x-y sections (default: '
                    f'{DEFAULT_VIEWS}; with -n EVENTS: {DEFAULT_EVENT_VIEWS})')
    ap.add_argument('--formats', default='svg,pdf,png')
    ap.add_argument('--segments', type=int, default=72, help='line segments per full circle (default 72)')
    ap.add_argument('--name', default='{config}_{view}',
                    help="output file name without extension, with {config} and {view} (default '{config}_{view}')")
    ap.add_argument('--field', default=None, metavar='FILE',
                    help='field file for the field views: a GEMC 2-D map or a field.npz of solid_field_dump '
                         '(default: the total field of the configuration, sampled with solid_field_dump)')
    ap.add_argument('--keep', action='store_true', help='keep the work directory with the scene.npz or .prim file')
    ap.add_argument('lineview_args', nargs='*', help='extra arguments passed to solid_lineview (after --)')
    a = ap.parse_args()

    os.makedirs(a.outdir, exist_ok=True)
    lineview = find_lineview()
    path = os.environ.get('DETECTOR_PATH', '.')
    compact = os.path.join(path, a.config + '.xml')
    steering = os.path.join(path, 'steering', 'solid_sim.py')

    workdir = evdir = None
    if a.prim:
        prim = os.path.abspath(a.prim)
    else:
        workdir = tempfile.mkdtemp(prefix=f'views_{a.config}_', dir=os.path.abspath(a.outdir))
        if a.events > 0 and a.source == 'scene':
            prim, evdir = make_events(compact, workdir, a.events, a.segments, steering)
        elif a.source == 'scene':
            prim = make_scene(compact, workdir, a.segments)
        else:
            prim = make_prim(compact, workdir, a.events, a.segments, steering)
    print('scene file:', prim, flush=True)
    fields = {}                                     # plane -> field.npz of this run
    tmpdir = None                                   # for field files when the scene was given
    if a.views is None:
        a.views = DEFAULT_EVENT_VIEWS if evdir else DEFAULT_VIEWS

    status = 0
    for view in [v.strip() for v in a.views.split(',') if v.strip()]:
        if evdir and (view in EVENT_VIEWS or view.startswith('beam_')):
            # events on the drawing: solid_evview (several events are overlaid)
            kind, phi = EVENT_VIEWS.get(view, ('beam', None))
            cmd = [sys.executable, find_tool('solid_evview'), evdir, '--scene', prim, '-o', a.outdir,
                   '--views', kind, '--formats', a.formats, '--name', a.name.format(config=a.config, view=view),
                   '--title', '%s: %s, %d event%s' % (a.config, view, a.events, 's' if a.events > 1 else '')]
            if a.events > 1:
                cmd.append('--overlay')
            if phi is not None:
                cmd += ['--phi', str(phi)]
            if view.startswith('beam_'):
                cmd += ['--zsec', '%scm' % float(view.split('_', 1)[1])]
            if a.animate and view == 'event_side':
                cmd += ['--animate', 'side']
            print('+', ' '.join(cmd), flush=True)
            status |= subprocess.run(cmd).returncode
            continue
        if view.startswith('event_'):
            print(f'{view}: needs -n EVENTS with --source scene, skipped', file=sys.stderr)
            continue
        if view.startswith('beam_'):
            z_cm = float(view.split('_', 1)[1])
            opts = ['--mode', 'section', '--section', f'z={z_cm}cm', '--view', 'beam', '--fill', '--scale-bar']
        elif view in FIELD_VIEWS:
            plane, fopts, where = FIELD_VIEWS[view]
            fmap = a.field
            if not fmap:
                if plane not in fields:
                    if workdir is None and tmpdir is None:
                        tmpdir = tempfile.mkdtemp(prefix=f'views_{a.config}_', dir=os.path.abspath(a.outdir))
                    fields[plane] = make_field(compact, workdir or tmpdir, plane)
                fmap = fields[plane]
            if not fmap:
                print(f'{view}: no field file, skipped', file=sys.stderr)
                status |= 1
                continue
            opts = FIELD_BASE + fopts + ['--field', fmap]
        elif view in VIEWS:
            opts = list(VIEWS[view])
        else:
            print(f'unknown view {view}, skipped', file=sys.stderr)
            continue
        outs = []
        for fmt in a.formats.split(','):
            outs += ['-o', os.path.join(a.outdir, a.name.format(config=a.config, view=view) + '.' + fmt.strip())]
        if view == 'overview':
            titles = ['--title', DISPLAY_NAMES.get(a.config, a.config), '--subtitle', SUBTITLE.format(config=a.config)]
        elif view in FIELD_VIEWS:
            what = 'field of %s' % os.path.basename(a.field) if a.field else 'total field of the configuration'
            titles = ['--title', DISPLAY_NAMES.get(a.config, a.config) + ': magnetic field',
                      '--subtitle', '%s.xml · %s, %s' % (a.config, what, where)]
        else:
            titles = ['--title', f'{a.config}: {view}']
        cmd = [sys.executable, lineview, prim] + opts + outs + titles + a.lineview_args
        print('+', ' '.join(cmd), flush=True)
        r = subprocess.run(cmd)
        status |= r.returncode
    for d in (workdir, tmpdir):
        if d and not a.keep:
            shutil.rmtree(d, ignore_errors=True)
    return status


if __name__ == '__main__':
    sys.exit(main())
