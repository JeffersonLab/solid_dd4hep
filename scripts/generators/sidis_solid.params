mc.num_events        100000
file.gen             gen.root
file.event           event.root
file.write_momenta   on
file.write_photon    on
phys.sf_set          prokudin
phys.rc_method       approx
phys.soft_threshold  0.01
phys.mass_threshold  1.073249081
setup.beam           e
setup.target         n
setup.hadron         pi+
setup.beam_energy    11.0
setup.beam_pol       0
setup.target_pol     0 0 0
cut.Q_sq             1 12
cut.W_sq             5.29 25
cut.z                0.3 0.7
cut.lab.theta_k2     6 28
cut.lab.theta_h      6 18
cut.lab.mom_k2       0.8 8
cut.lab.mom_h        0.8 8
