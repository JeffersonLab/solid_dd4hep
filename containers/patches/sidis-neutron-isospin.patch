+// Flavor whose proton distribution is the distribution of flavor `fl` in the
+// target. For the neutron this is the isospin rotation u <-> d, ubar <-> dbar:
+// the neutron's u quarks are distributed like the proton's d quarks. Applied
+// to the parton distributions only; charges and fragmentation functions keep
+// the flavor of the struck quark.
+unsigned ProkudinSfSet::iso(unsigned fl) const {
+	if (target != part::Nucleus::N) {
+		return fl;
+	}
+	switch (fl) {
+	case 0:
+		return 1;
+	case 1:
+		return 0;
+	case 3:
+		return 4;
+	case 4:
+		return 3;
+	default:
+		return fl;
+	}
+}
